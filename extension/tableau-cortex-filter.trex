<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.martinregan.tableau-cortex-filter" extension-version="0.1.0">
    <default-locale>en_GB</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="Martin Regan" email="" organization="" website="https://localhost"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>http://localhost:8765/extension/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_GB">F1 AI Assistant</text>
    </resource>
    <resource id="description">
      <text locale="en_GB">A Tableau Extension that uses a Snowflake Cortex Agent to answer Formula 1 questions and filter a dashboard.</text>
    </resource>
  </resources>
</manifest>
